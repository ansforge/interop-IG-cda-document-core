         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "code" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "http://hl7.org/cda/stds/core/StructureDefinition/cs-simple|2.0.3-sd" ;
           fhir:index -1 ;
           fhir:link <http://hl7.org/cda/stds/core/StructureDefinition/cs-simple|2.0.3-sd>
         ]
       ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "http://hl7.org/cda/stds/core/ValueSet/CDANullFlavor|2.0.3-sd" ;
           fhir:link <http://hl7.org/cda/stds/core/ValueSet/CDANullFlavor|2.0.3-sd>
         ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "AD.isNotOrdered" ] ;
       fhir:ElementDefinition.path [ fhir:value "AD.isNotOrdered" ] ;
       fhir:ElementDefinition.representation [
         fhir:value "xmlAttr" ;
         fhir:index -1
       ] ;
       fhir:ElementDefinition.label [ fhir:value "Is Not Ordered" ] ;
       fhir:ElementDefinition.definition [ fhir:value "A boolean value specifying whether the order of the address parts is known or not. While the address parts are always a Sequence, the order in which they are presented may or may not be known. Where this matters, the isNotOrdered property can be used to convey this information." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "AD.isNotOrdered" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
