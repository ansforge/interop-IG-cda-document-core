<https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/cisis-addr> a fhir:StructureDefinition ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "cisis-addr"] ;
