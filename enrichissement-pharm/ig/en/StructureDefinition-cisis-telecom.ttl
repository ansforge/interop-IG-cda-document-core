       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/elementdefinition-defaulttype" ] ;
         fhir:Extension.valueCanonical [
           fhir:value "http://hl7.org/cda/stds/core/StructureDefinition/SXPR-TS|2.0.3-sd" ;
           fhir:link <http://hl7.org/cda/stds/core/StructureDefinition/SXPR-TS|2.0.3-sd>
         ]
       ] ;
       fhir:ElementDefinition.path [ fhir:value "TEL.useablePeriod" ] ;
       fhir:ElementDefinition.representation [
         fhir:value "typeAttr" ;
         fhir:index -1
       ] ;
       fhir:ElementDefinition.label [ fhir:value "Useable Period" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Specifies the periods of time during which the telecommunication address can be used. For a telephone number, this can indicate the time of day in which the party can be reached on that telephone. For a web address, it may specify a time range in which the web content is promised to be available under the given address." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "TEL.useablePeriod" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "*" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "http://hl7.org/cda/stds/core/StructureDefinition/IVL-TS" ]
       ], [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "http://hl7.org/cda/stds/core/StructureDefinition/EIVL-TS" ]
       ], [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "http://hl7.org/cda/stds/core/StructureDefinition/PIVL-TS" ]
       ], [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "http://hl7.org/cda/stds/core/StructureDefinition/SXPR-TS" ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "TEL.use" ] ;
       fhir:ElementDefinition.path [ fhir:value "TEL.use" ] ;
       fhir:ElementDefinition.representation [
         fhir:value "xmlAttr" ;
         fhir:index -1
       ] ;
       fhir:ElementDefinition.label [ fhir:value "Use Code" ] ;
       fhir:ElementDefinition.short [ fhir:value "Code d'usage formé d'un à plusieurs codes séparés les uns des autres par un espace. \r\n\nLes valeurs permises sont les suivantes :\n'H' pour domicile\n'HP' pour domicile principal\n'HV' pour lieu de vacances\n'WP' pour lieu de travail\n'DIR' pour numéro direct\n'PUB' pour numéro public (standard)\n'EC' pour numéro d'urgence\n'MC' pour téléphone mobile\n'PG' pour beeper" ] ;
       fhir:ElementDefinition.definition [ fhir:value "One or more codes advising a system or user which telecommunication address in a set of like addresses to select for a given telecommunication need." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "TEL.use" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "*" ]
       ] ;
