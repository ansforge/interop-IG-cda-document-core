         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "code" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "http://hl7.org/cda/stds/core/StructureDefinition/cs-simple|2.0.3-sd" ;
           fhir:index -1 ;
           fhir:link <http://hl7.org/cda/stds/core/StructureDefinition/cs-simple|2.0.3-sd>
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ] ;
