       fhir:Element.id [ fhir:value "SubstanceAdministration.precondition" ] ;
       fhir:ElementDefinition.path [ fhir:value "SubstanceAdministration.precondition" ] ;
       fhir:ElementDefinition.short [ fhir:value "Précondition : \r\n\nPermet de décrire les conditions préalables à l'utilisation du médicament.      L'attribut @value de l'élément 'reference' est une URI qui pointe vers la partie narrative du document CDA décrivant ces conditions préalables. " ] ;
