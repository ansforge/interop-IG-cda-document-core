         ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "SubstanceAdministration.routeCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "SubstanceAdministration.routeCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "Voie d'administration : Si la voie d'administration est connue, elle doit être indiquée (code et displayName). Si elle n'est pas connue, la raison pour laquelle elle est inconnue peut être décrite en utilisant l'attribut nullFlavor.Terminologie utilisée :  EDQM - Standard terms / classe ROA (Voie d'administration)" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Voie d'administration" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "SubstanceAdministration.approachSiteCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "SubstanceAdministration.approachSiteCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "Région anatomique d'administration : La région anatomique d'administration provient du JDV_HumanSubstanceAdministrationSite_CISIS (1.2.250.1.213.1.1.5.686) (Terminologie SNOMED CT 2.16.840.1.113883.6.96). Cet élément doit contenir une référence pointant sur l'élément correspondant de la partie narrative où la région anatomique est décrite." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Région anatomique d'administration" ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://smt.esante.gouv.fr/fhir/ValueSet/jdv-human-substance-administration-site-cisis|20260619134041" ;
