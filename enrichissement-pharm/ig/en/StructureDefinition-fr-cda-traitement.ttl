         fhir:ElementDefinition.constraint.human [ fhir:value "La fréquence doit être SXCM-TS, PIVL-TS, EIVL-TS ou SXPR-TS" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "is(SXCM_TS) or is(PIVL_TS) or is(EIVL_TS) or is(SXPR_TS)" ] ;
