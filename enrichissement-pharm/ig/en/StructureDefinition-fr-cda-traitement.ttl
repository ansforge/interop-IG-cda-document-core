       fhir:Element.id [ fhir:value "SubstanceAdministration.entryRelationship:frInstructionsAuPatient.typeCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "SubstanceAdministration.entryRelationship.typeCode" ] ;
       fhir:ElementDefinition.patternCode [ fhir:value "SUBJ" ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "SubstanceAdministration.entryRelationship:frInstructionsAuPatient.inversionInd" ] ;
       fhir:ElementDefinition.path [ fhir:value "SubstanceAdministration.entryRelationship.inversionInd" ] ;
       fhir:ElementDefinition.patternBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "SubstanceAdministration.entryRelationship:frInstructionsAuPatient.act" ] ;
       fhir:ElementDefinition.path [ fhir:value "SubstanceAdministration.entryRelationship.act" ] ;
       fhir:ElementDefinition.short [ fhir:value "Instruction au patient : \r\n\nLes instructions au patient peuvent être transmises, sous forme textuelle, dans une entrée Instructions au patient (Patient Medication Instructions – 1.3.6.1.4.1.19376.1.5.3.1.4.3) portée par un élément \"entryRelationship\"." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Instructions au patient" ] ;
       fhir:ElementDefinition.type [
