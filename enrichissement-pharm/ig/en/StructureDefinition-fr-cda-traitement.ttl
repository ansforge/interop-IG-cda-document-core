       fhir:ElementDefinition.path [ fhir:value "SubstanceAdministration.approachSiteCode.originalText" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "SubstanceAdministration.approachSiteCode.originalText.reference" ] ;
       fhir:ElementDefinition.path [ fhir:value "SubstanceAdministration.approachSiteCode.originalText.reference" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "SubstanceAdministration.doseQuantity" ] ;
       fhir:ElementDefinition.path [ fhir:value "SubstanceAdministration.doseQuantity" ] ;
       fhir:ElementDefinition.short [ fhir:value "Dose à administrer : \r\n\nS'il n'y a pas de traitement, utiliser une valeur nullFlavor.\nS'il y a un traitement, les sous-éléments 'low' et 'high' permettent de fournir les doses minimales et maximales à administrer. Dans le cas où la dose est fixe, ces deux sous-éléments prendront les mêmes valeurs. Dans chaque élément 'low' et 'high', un élément 'translation' peut permettre de pointer sur l'élément de la partie narrative relative à cette information.\nDans le cas où l'on s'exprime en quantités indénombrables, l'unité doit être transmise. Les unités sont exprimées selon le système de codage UCUM.\nDans le cas où l'on s'exprime en quantités dénombrables (capsules, comprimés, gélules, etc.) l'unité ne doit pas être renseignée. A la place, on ajoute un champ 'translation' qui permet de pointer sur l'élément de la partie narrative relative à cette information." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Dose à administrer" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "SubstanceAdministration.doseQuantity.low" ] ;
       fhir:ElementDefinition.path [ fhir:value "SubstanceAdministration.doseQuantity.low" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
