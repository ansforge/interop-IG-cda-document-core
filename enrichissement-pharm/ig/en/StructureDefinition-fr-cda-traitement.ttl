           fhir:link <https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-instructions-au-patient|0.1.0>
         ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "SubstanceAdministration.entryRelationship:frReferenceInterne" ] ;
       fhir:ElementDefinition.path [ fhir:value "SubstanceAdministration.entryRelationship" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "frReferenceInterne" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
