  ], [
     fhir:index -1 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/xml-namespace" ] ;
     fhir:Extension.valueUri [ fhir:value "urn:hl7-org:v3" ]
