       fhir:ElementDefinition.short [ fhir:value "Nombre de renouvellement(s) possible(s): \r\n\n- Si aucun renouvellement autorisé (dispensation unique) : <repeatNumber value='0'/>\n- Si le renouvellement n'est pas limité (par ex : si une période de renouvellement est définie), la valeur est fixée à nullFlavor='NI'." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "SubstanceAdministration.routeCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "SubstanceAdministration.routeCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "Voie d'administration : \r\n\nDans le cas où la posologie n'est pas structurée et décrite uniquement dans la partie narrative, cet élément ne doit pas être présent.   \nDans le cas où la posologie est structurée, si la voie d'administration est connue, elle peut être indiquée à partir de la terminologie EDQM (0.4.0.127.0.16.1.1.2.1).      \nSi elle n'est pas connue, la raison pour laquelle elle est inconnue peut être décrite en utilisant l'attribut nullFlavor." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Voie d'administration" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
