       fhir:ElementDefinition.path [ fhir:value "SubstanceAdministration.approachSiteCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "région anatomique d'administration :\nDans le cas où la posologie n'est pas structurée et décrite uniquement dans la partie narrative, cet élément ne doit pas être présent.   \nDans le cas où la posologie est structurée, si la région anatomique d'administration est connue, elle peut être indiquée." ] ;
