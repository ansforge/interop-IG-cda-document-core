       fhir:ElementDefinition.sliceName [ fhir:value "iheModeAdministrationNormal" ] ;
       fhir:ElementDefinition.short [ fhir:value "Mode d'administration : normal. \nAdministration sans précaution particulière à prendre. Dans ce cas, ne pas utiliser de  subordonné." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Mode d'administration: normal" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
