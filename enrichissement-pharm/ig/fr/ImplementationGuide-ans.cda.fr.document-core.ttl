       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "CDA - FR DICOM Addendum" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "DICOM Part 20 - Addendum Section\n - La section Addendum permet d'enregistrer, dans une nouvelle version du compte-rendu, des informations correctives ou complémentaires par rapport au compte-rendu initial." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
