       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-dicom-administration-radiopharmaceutique> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/fr-cda-dicom-administration-radiopharmaceutique" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "CDA - FR DICOM Administration radiopharmaceutique" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Entrée FR-DICOM-Administration-radiopharmaceutique: Cette entrée permet d'enregistrer l’administration de produits radiopharmaceutiques :\n - produit administré \n - dose administrée \n - voie d’administration\n - numéro de lot\n - autres informations liées à l’administration d’un produit" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
