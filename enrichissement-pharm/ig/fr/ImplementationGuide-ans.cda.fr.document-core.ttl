       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "CDA - FR Statut clinique du patient" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Entrée FR-Statut-clinique-du-patient: IHE-PCC - Health-Status-Observation. L'entrée Statut clinique du patient permet de donner une évaluation de l'état clinique du patient. L'entrée Statut clinique du patient est un élément observation qui est inséré dans un autre élément à l'aide d'un lien entryRelationship." ] ;
