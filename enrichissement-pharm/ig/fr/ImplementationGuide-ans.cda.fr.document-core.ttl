       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "CDA - FR DICOM Administration produit de sante" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Entrée FR-DICOM-Administration-produit-de-sante: DICOM Part 20 - Procedural Medication. Cette entrée permet d'enregistrer l’administration de produits (hors radiopharmaceutiques) :\n - produit administré \n - dose administréevoie d’administration\n - numéro de lot\n - autres informations liées à l’administration d’un produit" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
