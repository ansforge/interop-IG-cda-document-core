         fhir:code [ fhir:v "http://hl7.org/cda/stds/core/StructureDefinition/RecordTarget"^^xsd:anyURI ] ;
         fhir:profile ( [
           fhir:v "https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-record-target|0.1.0"^^xsd:anyURI ;
