       ] ;
       fhir:name [ fhir:v "CDA - FR Traitement prescrit" ] ;
       fhir:description [ fhir:v "Entrée FR-Traitement-prescrit: IHE-PRE Prescription Item. Cette entrée de type substanceAdministration permet de décrire un traitement prescrit avec notamment le médicament, le mode d’administration, la quantité, la durée et la fréquence d'administration." ] ;
       fhir:isExample [ fhir:v false ] ;
