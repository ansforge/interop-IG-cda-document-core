       ] ;
       fhir:name [ fhir:v "CDA - FR Commentaire non code" ] ;
       fhir:description [ fhir:v "IHE-PCC - Document-Summary \n - Cette section permet d'indiquer un commentaire sous forme textuelle." ] ;
       fhir:isExample [ fhir:v false ] ;
       fhir:groupingId [ fhir:v "ressources-cda-corps-sections" ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
