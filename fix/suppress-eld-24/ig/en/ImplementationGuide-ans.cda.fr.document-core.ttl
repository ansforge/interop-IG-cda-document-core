           a fhir:string ;
           fhir:v "StructureDefinition:logical"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-code-a-barres> ;
         fhir:reference [ fhir:v "StructureDefinition/fr-cda-code-a-barres" ]
       ] ;
       fhir:name [ fhir:v "CDA - FR Code a barres" ] ;
       fhir:description [ fhir:v "Cette section permet d'enregistrer des codes à barres" ] ;
       fhir:isExample [ fhir:v false ] ;
       fhir:groupingId [ fhir:v "ressources-cda-corps-sections" ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:logical"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-commentaire-er> ;
         fhir:reference [ fhir:v "StructureDefinition/fr-cda-commentaire-er" ]
       ] ;
       fhir:name [ fhir:v "CDA - FR Commentaire ER" ] ;
       fhir:description [ fhir:v "Entrée FR-Commentaire-ER: IHE-PCC - Comments L’entrée FR-Commentaire-ER est un élément qui permet de joindre un commentaire à une entrée ou à une section.  Note : IHE PCC a limité l’utilisation de l’élément « Comments » (1.3.6.1.4.1.19376.1.5.3.1.4.2) aux entrées de type observation et organizer. Ce n’est pas le cas dans CDD pour l’élément « Comment » (2.16.840.1.113883.10.20.1.40). Dans le CI-SIS, le choix a été fait de ne pas limiter l’utilisation de l’entrée FR-Commentaire-ER (1.3.6.1.4.1.19376.1.5.3.1.4.2) comme dans CCD. Lorsque l’entrée FR-Commentaire-ER est utilisée dans une entrée : de type organizer : l’utiliser dans un élément component avec l’attribut type-Code='COMP'.de type observation ou act, etc… : l’utiliser dans un élément entryRelationship avec les attributs typeCode='SUBJ' et inversionInd='true'." ] ;
       fhir:isExample [ fhir:v false ] ;
       fhir:groupingId [ fhir:v "ressources-cda-corps-composants-elementaires" ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
