       fhir:reference [
         fhir:link <https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-dicom-acte-imagerie> ;
         fhir:reference [ fhir:v "StructureDefinition/fr-cda-dicom-acte-imagerie" ]
       ] ;
       fhir:name [ fhir:v "CDA - FR DICOM Acte imagerie" ] ;
       fhir:description [ fhir:v "DICOM Part 20 - Imaging Procedure Description Section\n - Cette section permet d'enregistrer les informations sur les détails techniques de l'acte d'imagerie et peut inclure des informations sur le protocole, le dispositif d’imagerie, le contraste, la dose de rayonnement, les médicaments administrés." ] ;
