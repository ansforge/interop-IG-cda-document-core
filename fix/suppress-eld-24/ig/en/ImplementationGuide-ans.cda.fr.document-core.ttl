       fhir:reference [
         fhir:link <https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-certitude> ;
         fhir:reference [ fhir:v "StructureDefinition/fr-cda-certitude" ]
       ] ;
       fhir:name [ fhir:v "CDA - FR Certitude" ] ;
       fhir:description [ fhir:v "Entrée FR-Certitude: Cette entrée permet de fournir la certitude d'une observation (problème ou allergie/hypersensibilité). Elle est utilisée exclusivement dans un lien entryRelationship grâce auquel elle est liée à l’élément qu’elle qualifie." ] ;
       fhir:isExample [ fhir:v false ] ;
       fhir:groupingId [ fhir:v "ressources-cda-corps-composants-elementaires" ]
