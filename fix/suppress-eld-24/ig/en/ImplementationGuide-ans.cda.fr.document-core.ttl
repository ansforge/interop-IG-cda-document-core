       ] ;
       fhir:name [ fhir:v "CDA - FR Administration de derives du sang" ] ;
       fhir:description [ fhir:v "Entrée FR-Administration-de-derives-du-sang: IHE-PCC - Simple-Observation Cette entrée permet d'indiquer s'il y a eu ou pas une administration de dérivés du sang." ] ;
