         fhir:profile ( [
           fhir:v "https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-acte-substitution|0.1.0"^^xsd:anyURI ;
           fhir:link <https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-acte-substitution|0.1.0>
         ] )
       ] )
