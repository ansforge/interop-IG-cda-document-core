         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Le rythme d'administration porte soit un nullFlavor, soit les sous-éléments low et high." ] ;
         fhir:expression [ fhir:v "nullFlavor.exists() or (low.exists() and high.exists())" ] ;
